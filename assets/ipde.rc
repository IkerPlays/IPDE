#include <winver.h>
#include "version.h"

IDI_ICON1 ICON "ipde.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION IPDE_RC_MAJOR,IPDE_RC_MINOR,IPDE_RC_PATCH,0
PRODUCTVERSION IPDE_RC_MAJOR,IPDE_RC_MINOR,IPDE_RC_PATCH,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "CompanyName", "IkersStudio"
			VALUE "FileDescription", "IPDE"
			VALUE "FileVersion", IPDE_VERSION_NUMBER
			VALUE "ProductName", "IPDE"
			VALUE "ProductVersion", IPDE_VERSION_NUMBER
			VALUE "LegalCopyright", "(c) IkersStudio"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
