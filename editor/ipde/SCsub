#!/usr/bin/env python
from misc.utility.scons_hints import *

import os

import methods

Import("env")

# Built-in token for the IPDE updater (to read releases of a private repository).
# It comes from the `IPDE_UPDATER_TOKEN` environment variable (a GitHub Actions secret),
# is never committed, and is only lightly obfuscated: it can be extracted from the binary.
_IPDE_TOKEN_KEY = b"IkersStudio-IPDE-Updater"


def ipde_token_builder(target, source, env):
    with methods.generated_wrapper(str(target[0])) as file:
        file.write(f'#define IPDE_UPDATER_TOKEN_OBF "{source[0].read()}"\n')


_token = os.environ.get("IPDE_UPDATER_TOKEN", "").strip().encode()
_obf = bytes(b ^ _IPDE_TOKEN_KEY[i % len(_IPDE_TOKEN_KEY)] for i, b in enumerate(_token)).hex()
env.CommandNoCache("ipde_token.gen.h", env.Value(_obf), env.Run(ipde_token_builder))

env.add_source_files(env.editor_sources, "*.cpp")
