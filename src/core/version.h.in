#pragma once

#define IPDE_VERSION_NUMBER "@IPDE_VERSION@"
#define IPDE_VERSION_MAJOR (@PROJECT_VERSION_MAJOR@ + 0)
#define IPDE_VERSION_MINOR (@PROJECT_VERSION_MINOR@ + 0)
#define IPDE_VERSION_PATCH (@PROJECT_VERSION_PATCH@ + 0)
// Plain numbers for the Windows resource compiler.
#define IPDE_RC_MAJOR @PROJECT_VERSION_MAJOR@
#define IPDE_RC_MINOR @PROJECT_VERSION_MINOR@
#define IPDE_RC_PATCH @PROJECT_VERSION_PATCH@
#define IPDE_VERSION_CHANNEL "@IPDE_CHANNEL@"
#define IPDE_REPOSITORY "@IPDE_REPOSITORY@"
#define IPDE_VERSION_DISPLAY "IPDE v." IPDE_VERSION_NUMBER
